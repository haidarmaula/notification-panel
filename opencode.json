{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "edit": {
          "*": "allow",
          "**/*_test.go": "deny",
          "docs/**": "deny"
        },
        "bash": {
          "*": "ask",
          "go *": "allow",
          "git push *": "deny"
        }
      }
    }
  }
}
