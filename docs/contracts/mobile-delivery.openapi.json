{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobile installations, receipts and campaign delivery",
    "version": "1.0.0",
    "description": "External HTTPS through the deployment gateway. All examples use synthetic identities. All operations reject unknown query parameters and return Cache-Control no-store. JSON requests allow application/json with optional UTF-8 charset. No client supplies forwarded headers."
  },
  "paths": {
    "/api/v1/apps/{app_id}/mobile/installations": {
      "post": {
        "tags": ["Installations"],
        "summary": "Enroll a device installation",
        "operationId": "enrollInstallation",
        "description": "Obtain one installation proof. Replace all synthetic credentials in the example with real credentials issued for the test environment.",
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "MobileBearer": []
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "201": {
            "description": "Acknowledged outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrolled"
                },
                "example": {
                  "success": true,
                  "message": "success",
                  "data": {
                    "installation_id": "10000000-0000-4000-8000-000000000003",
                    "version": "1",
                    "owner_epoch": "1",
                    "proof": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Enrollment"
              },
              "example": {
                "platform": "ANDROID",
                "address_type": "FCM_REGISTRATION_TOKEN",
                "address": "synthetic-provider-address",
                "origin": "synthetic-origin-replace-with-provider-assertion"
              }
            }
          }
        }
      }
    },
