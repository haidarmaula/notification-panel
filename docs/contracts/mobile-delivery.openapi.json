            "description": "Acknowledged outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                },
                "example": {
                  "success": true,
                  "message": "success",
                  "data": {
                    "schema_version": 1,
                    "snapshot_complete": true,
                    "observation_coverage": "reporting_devices_only",
                    "counts": {
                      "targeted_users": 0,
                      "eligible_users": 0,
                      "targeted_devices": 0,
                      "pending_devices": 0,
                      "provider_accepted_devices": 0,
                      "submission_failed_devices": 0,
                      "observed_devices": 0,
                      "opened_devices": 0,
                      "opened_users": 0,
                      "failed_observed_devices": 0
                    }
