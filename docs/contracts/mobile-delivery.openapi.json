  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "success",
          "message"
        ],
        "additionalProperties": false
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS"
            ]
          },
          "address_type": {
            "type": "string",
            "enum": [
              "FCM_REGISTRATION_TOKEN",
              "FCM_FID"
            ]
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "Provider address. Maximum 4096 UTF-8 bytes. Only configured platform/address-type pairs are accepted."
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "description": "Single-use origin assertion bound to this project and exact mobile JWT."
