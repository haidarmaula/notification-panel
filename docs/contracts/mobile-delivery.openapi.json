    "/api/v1/apps/{app_id}/mobile/notifications/{campaign_id}/receipt": {
      "post": {
        "tags": ["Receipts"],
        "summary": "Report a delivery or open observation",
        "operationId": "reportDeviceReceipt",
        "description": "Retry an uncertain report with the same client event ID and original capability. Requires receipt policy, current installation ownership and project identity. Maximum 4096 body bytes.",
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Positive decimal int64."
            }
          }
        ],
        "security": [
          {
            "MobileBearer": []
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "410": {
            "$ref": "#/components/responses/Error410"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "200": {
            "description": "Acknowledged outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acknowledged"
                },
                "example": {
                  "success": true,
                  "message": "receipt acknowledged"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Receipt"
              },
              "example": {
                "delivery_id": "10000000-0000-4000-8000-000000000004",
                "client_event_id": "10000000-0000-4000-8000-000000000005",
                "event": "OPENED",
                "receipt_token": "synthetic-capability-replace-with-original-payload",
                "observed_at": "2030-01-01T00:00:00Z"
              }
            }
          }
        }
      }
    },
    "/api/v1/apps/{app_id}/campaigns/{campaign_id}/send": {
      "post": {
        "tags": ["Campaign delivery"],
        "summary": "Accept a campaign for sending",
        "operationId": "acceptCampaign",
        "description": "Empty request body. Acceptance commits the outbox before replying. Requires current send permission and an explicit application grant.",
        "parameters": [
          {
            "name": "app_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Positive decimal int64."
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "One value with no control characters. Omit or empty to derive a per-campaign key."
          }
        ],
        "security": [
          {
            "StaffAPIKey": [],
            "StaffBearer": []
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "202": {
            "description": "Acknowledged outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                },
                "example": {
                  "success": true,
                  "message": "campaign accepted",
                  "data": {
                    "id": "42",
                    "status": "QUEUED",
                    "queued_at": "2030-01-01T00:00:00Z",
                    "deadline_at": "2030-01-01T01:00:00Z"
                  }
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                },
                "description": "Whether the original accepted snapshot was returned."
              }
            }
          }
        }
      }
    },
