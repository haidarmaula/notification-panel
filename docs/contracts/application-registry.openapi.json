      "OptionalIfMatch": {
        "name": "If-Match",
        "in": "header",
        "schema": {
          "type": "string"
        },
        "description": "Required for existing/reactivated grant; mutually exclusive with If-None-Match."
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "schema": {
          "const": "*"
        },
        "description": "Required for first grant row; mutually exclusive with If-Match. If neither: 428."
      }
