{
  "name": "@hello/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "api:generate": "openapi-typescript ../../docs/contracts/staff-business.openapi.json -o src/lib/api/generated/staff.ts && openapi-typescript ../../docs/contracts/application-registry.openapi.json -o src/lib/api/generated/applications.ts",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@kobalte/core": "0.13.14",
    "@solidjs/router": "1.0.3",
    "@tanstack/solid-query": "5.107.1",
    "date-fns": "4.4.0",
    "lucide-solid": "1.72.0",
    "solid-js": "1.9.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-solid": "0.19.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16",
    "vitest": "5.1.0"
  }
}
