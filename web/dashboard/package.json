{
  "name": "@hello/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "api:generate": "openapi-typescript ../../docs/contracts/staff-business.openapi.json -o src/lib/api/generated/staff.ts && openapi-typescript ../../docs/contracts/application-registry.openapi.json -o src/lib/api/generated/applications.ts && openapi-typescript ../../docs/contracts/application-onboarding.openapi.json -o src/lib/api/generated/onboarding.ts",
    "budget": "node scripts/bundle-budget.mjs",
    "preview:astryx": "vite --config preview/vite.config.ts",
    "build:astryx": "tsc --noEmit -p preview/tsconfig.json && vite build --config preview/vite.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-butter": "0.7.16",
    "@astryxdesign/theme-chocolate": "0.7.16",
    "@astryxdesign/theme-gothic": "0.7.16",
    "@astryxdesign/theme-matcha": "0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@astryxdesign/theme-stone": "0.7.16",
    "@astryxdesign/theme-y2k": "0.7.16",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fustat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manufacturing-consent": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playwrite-us-trad": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/sarina": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
