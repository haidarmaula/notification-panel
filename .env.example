# Used by Make migration commands; ./dev uses private settings under tmp/local-dev/.
DB_HOST=postgres
DB_PORT=5432
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=your-db-name
DB_SSLMODE=disable

API_KEY=your-secret-api-key
# Optional exact browser origins, comma-separated; empty denies cross-origin access.
CORS_ALLOWED_ORIGINS=
ACCESS_SECRET=your-secret-access-key
REFRESH_SECRET=your-secret-refresh-key

BOOTSTRAP_SUPER_ADMIN_NAME=super-admin-name 
BOOTSTRAP_SUPER_ADMIN_EMAIL=super-admin-email
BOOTSTRAP_SUPER_ADMIN_PASSWORD=super-admin-password
